# Copy this file to .env on the VPS. Do not commit the actual .env file.
POSTGRES_USER=fact_checker
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=fact_checker
DATABASE_URL=postgresql://fact_checker:replace-with-a-long-random-password@postgres:5432/fact_checker?schema=public

# nip.io resolves this hostname to the VPS IP; Nginx terminates HTTPS.
API_DOMAIN=180.93.37.237.nip.io
# Replace after the first Vercel deployment. You may list preview/local origins, comma-separated.
FRONTEND_URL=https://your-project.vercel.app
